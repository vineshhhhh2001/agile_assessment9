pipeline {
    agent any

    environment {
        DOCKER_IMAGE    = "YOUR_DOCKERHUB_USERNAME/event-portal"
        DOCKER_TAG      = "${BUILD_NUMBER}"
        KUBE_NAMESPACE  = "default"
        DEPLOYMENT_NAME = "event-portal-deployment"
    }

    stages {

        stage('Clone Code') {
            steps {
                echo '📥 Cloning repository from GitHub...'
                git branch: 'main',
                    url: 'https://github.com/vineshhhhh2001/agile_assessment9.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                dir('question3') {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Test Application') {
            steps {
                echo '🧪 Verifying Docker image builds successfully...'
                sh """
                    docker run -d --name event-test -p 8097:80 ${DOCKER_IMAGE}:${DOCKER_TAG}
                    sleep 5
                    curl -sf http://localhost:8097 | grep -q 'EventSphere' && echo 'SMOKE TEST PASSED ✅' || (echo 'SMOKE TEST FAILED ❌' && exit 1)
                    docker rm -f event-test
                """
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                echo '☁️ Pushing image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '☸️ Deploying to Kubernetes with 3 replicas (Rolling Update)...'
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl set image deployment/${DEPLOYMENT_NAME} \
                            event-portal=${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -n ${KUBE_NAMESPACE} --record || \
                        kubectl apply -f question3/deployment.yaml -n ${KUBE_NAMESPACE}

                        kubectl rollout status deployment/${DEPLOYMENT_NAME} \
                            -n ${KUBE_NAMESPACE} --timeout=180s
                    """
                }
            }
        }

        stage('Verify – 3 Pods Running') {
            steps {
                echo '🔍 Verifying that all 3 Kubernetes Pods are running...'
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh "kubectl get pods -n ${KUBE_NAMESPACE} -l app=event-portal"
                    sh "kubectl get service event-portal-service -n ${KUBE_NAMESPACE}"
                    sh """
                        RUNNING=\$(kubectl get pods -n ${KUBE_NAMESPACE} -l app=event-portal --field-selector=status.phase=Running --no-headers | wc -l)
                        echo "Running pods: \$RUNNING"
                        if [ "\$RUNNING" -lt 3 ]; then echo 'ERROR: Less than 3 pods running!' && exit 1; fi
                    """
                }
            }
        }
    }

    post {
        failure {
            echo '🚨 Rolling update failed! Rolling back to previous stable release...'
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh "kubectl rollout undo deployment/${DEPLOYMENT_NAME} -n ${KUBE_NAMESPACE}"
                sh "kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${KUBE_NAMESPACE}"
                sh "kubectl get pods -n ${KUBE_NAMESPACE} -l app=event-portal"
                echo '✅ Rollback completed. Previous stable version is restored.'
            }
        }
        success {
            echo '🎉 Event Portal deployed successfully with 3 running pods!'
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
        }
    }
}
