pipeline {
    agent any

    environment {
        DOCKER_IMAGE     = "YOUR_DOCKERHUB_USERNAME/placement-portal"
        DOCKER_TAG       = "${BUILD_NUMBER}"
        KUBE_NAMESPACE   = "default"
        DEPLOYMENT_NAME  = "placement-portal-deployment"
    }

    stages {

        stage('Clone Code') {
            steps {
                echo '📥 Cloning repository from GitHub...'
                git branch: 'main',
                    url: 'https://github.com/vineshhhhh2001/agile_assessment9.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                dir('question1') {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Test Application') {
            steps {
                echo '🧪 Running smoke test on Docker container...'
                sh """
                    docker run -d --name placement-test -p 8099:80 ${DOCKER_IMAGE}:${DOCKER_TAG}
                    sleep 5
                    curl -sf http://localhost:8099 | grep -q 'PlacementHub' && echo 'TEST PASSED ✅' || (echo 'TEST FAILED ❌' && exit 1)
                    docker rm -f placement-test
                """
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                echo '☁️ Pushing image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo '☸️ Deploying to Kubernetes...'
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh """
                        kubectl set image deployment/${DEPLOYMENT_NAME} \
                            placement-portal=${DOCKER_IMAGE}:${DOCKER_TAG} \
                            -n ${KUBE_NAMESPACE} || \
                        kubectl apply -f question1/deployment.yaml -n ${KUBE_NAMESPACE}

                        kubectl rollout status deployment/${DEPLOYMENT_NAME} \
                            -n ${KUBE_NAMESPACE} --timeout=120s
                    """
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                echo '🔍 Verifying Kubernetes pods...'
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh "kubectl get pods -n ${KUBE_NAMESPACE} -l app=placement-portal"
                    sh "kubectl get service placement-portal-service -n ${KUBE_NAMESPACE}"
                }
            }
        }
    }

    post {
        failure {
            echo '🚨 Deployment failed! Initiating rollback...'
            withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                sh "kubectl rollout undo deployment/${DEPLOYMENT_NAME} -n ${KUBE_NAMESPACE}"
                sh "kubectl rollout status deployment/${DEPLOYMENT_NAME} -n ${KUBE_NAMESPACE}"
                echo '✅ Rollback completed successfully.'
            }
        }
        success {
            echo '🎉 Deployment successful! Application is running.'
        }
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
        }
    }
}
